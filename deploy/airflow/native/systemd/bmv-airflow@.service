[Unit]
Description=BMV Airflow %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bmv-airflow
Group=bmv-airflow
EnvironmentFile=/etc/bmv-filings/airflow.env
# Repository and virtual-environment paths come from the generated environment
# rather than being compiled into this unit.
ExecStart=/usr/bin/env --chdir=${PDFS_PROJECT_ROOT} ${PDFS_AIRFLOW_VENV}/bin/airflow %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
