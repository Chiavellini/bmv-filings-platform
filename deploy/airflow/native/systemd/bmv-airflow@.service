[Unit]
Description=BMV Airflow %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bmv-airflow
Group=bmv-airflow
WorkingDirectory=/opt/bmv-filings
EnvironmentFile=/etc/bmv-filings/airflow.env
ExecStart=/opt/bmv-filings/.airflow-venv/bin/airflow %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
