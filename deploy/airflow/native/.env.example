# Generated values belong in deploy/airflow/native/.env, which is gitignored.
AIRFLOW_HOME="/absolute/path/to/local/airflow-state"
AIRFLOW__CORE__DAGS_FOLDER="/absolute/path/to/repository/deploy/airflow/dags"
AIRFLOW__CORE__EXECUTOR="LocalExecutor"
AIRFLOW__CORE__LOAD_EXAMPLES="false"
AIRFLOW__CORE__DEFAULT_TIMEZONE="America/Mexico_City"
AIRFLOW__CORE__EXECUTION_API_SERVER_URL="http://127.0.0.1:8080/execution/"
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS="admin:admin"
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE="/absolute/path/to/local/airflow-state/simple_auth_manager_passwords.json"
AIRFLOW__CORE__FERNET_KEY="replace-me"
AIRFLOW__API_AUTH__JWT_SECRET="replace-me"
AIRFLOW__API_AUTH__JWT_ISSUER="bmv-filings-airflow"
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN="sqlite:////absolute/path/to/local/airflow-state/airflow.db"

PDFS_PROJECT_ROOT="/absolute/path/to/repository"
PDFS_DOCUMENT_ESTATE="/absolute/path/on/external/disk/document-estate"
PDFS_REPORTS_DIR="/absolute/path/on/external/disk/document-estate/views/reports"
PDFS_AIRFLOW_SYNC_ENABLED="false"
PDFS_AIRFLOW_ALLOW_COVERAGE_GAPS="true"
PDFS_AIRFLOW_RECHECK_LATEST="2"
PDFS_AIRFLOW_ONLY=""
PDFS_AIRFLOW_AUDIT_SCHEDULE="0 7 * * 1-5"
PDFS_AIRFLOW_SYNC_SCHEDULE="17 */6 * * *"

# Runs only after a successfully authorized sync and shares estate_writer.
PDFS_AIRFLOW_POST_SYNC_ENABLED="true"
PDFS_AIRFLOW_OUTBOX_BATCH_SIZE="250"
PDFS_AIRFLOW_OUTBOX_MAX_BATCHES="20"
PDFS_AIRFLOW_OUTBOX_BATCH_TIMEOUT_SECONDS="3600"
# Bump these whenever the corresponding derivative contract changes.
PDFS_AIRFLOW_PDF_PARSER_VERSION="1"
PDFS_AIRFLOW_XBRL_PROCESSOR_VERSION="1"

# Optional Alpha Go projection. Install its declared Python 3.12 environment
# before enabling this switch.
PDFS_AIRFLOW_ALPHA_ENABLED="false"
PDFS_AIRFLOW_ALPHA_ROOT="/absolute/path/to/repository/alpha-go"
PDFS_AIRFLOW_ALPHA_CORPUS="/absolute/path/on/external/disk/document-estate/indexes/alpha_go/corpus"
PDFS_AIRFLOW_ALPHA_INDEX="/absolute/path/on/external/disk/document-estate/indexes/alpha_go.db"
PDFS_AIRFLOW_ALPHA_CONFIG="/absolute/path/to/repository/alpha-go/configs/alpha_go.yaml"
PDFS_AIRFLOW_ALPHA_TARGET_ID="shared-estate-v1"
PDFS_AIRFLOW_ALPHA_PYTHON="/absolute/path/to/repository/alpha-go/.venv312/bin/python"
PDFS_AIRFLOW_ALPHA_TIMEOUT_SECONDS="1800"
TZ="America/Mexico_City"
