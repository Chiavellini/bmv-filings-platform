# Absolute path to the cloned source checkout. Native services need this when
# their working directory is outside the repository.
PDFS_PROJECT_ROOT=/absolute/path/to/repository

# Optional path to the single bridge file. Normal source checkouts discover
# estate.json at the repository root automatically.
PDFS_ESTATE_BRIDGE=/absolute/path/to/repository/estate.json

# External-disk Estate overrides for both interactive and automated use. Copy
# this file to untracked .env on each computer; keep tracked estate.json
# checkout-relative so a fresh clone never inherits another host's mount path.
PDFS_ESTATE_MOUNT_ROOT=/absolute/path/to/external/disk/mount
PDFS_DOCUMENT_ESTATE=/absolute/path/on/external/disk/document-estate
PDFS_ESTATE_ID=00000000-0000-0000-0000-000000000000

# Read-only compatibility view used by legacy extraction consumers.
PDFS_REPORTS_DIR=/absolute/path/on/external/disk/document-estate/views/reports

# Generated deliverables; not part of the durable document estate.
PDFS_OUTPUTS_DIR=/absolute/path/to/repository/outputs

# Required only for opt-in SEC EDGAR network fetches. SEC fair-access policy
# requires a descriptive application name and a monitored contact address.
SEC_EDGAR_USER_AGENT="bmv-filings-platform/0.1 operations@example.com"
