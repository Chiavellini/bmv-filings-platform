# Copy to an untracked .env on each computer:  cp .env.example .env
#
# Every line below is commented out on purpose. A copied placeholder is worse
# than no value: the launchpad bridge and every job it starts would inherit it.
# Uncomment a key only when you have this computer's real value for it.

# --- Document Estate on the USB ------------------------------------------------
# Easiest path: leave these commented, plug in the USB, and press
# "Conectar Estate" in the Analyst Console. It finds the USB by its
# .bmv-estate-volume.json sentinel and writes all three values here.
# To fill them by hand instead (e.g. for command-line use), find the mount with
# `diskutil list` / `df -h`, and the ID in <mount>/bmv-estate-v1/.bmv-estate-volume.json.
# The mount root and the ID are validated together: set both or neither.
# PDFS_ESTATE_MOUNT_ROOT=/Volumes/<USB name>
# PDFS_DOCUMENT_ESTATE=/Volumes/<USB name>/bmv-estate-v1
# PDFS_ESTATE_ID=<estate_id from .bmv-estate-volume.json>

# Alpha Go index generation that delivery receipts are recorded against.
# portable-estate-v2 is the certified index; v1 is superseded and unsafe to reuse
# (docs/ALPHA_GO_ESTATE_SYNC.md).
PDFS_ALPHA_TARGET_ID=portable-estate-v2

# --- Optional AI providers -------------------------------------------------------
# Nothing needs these. Alpha Go's Ask mode answers with a cited evidence pack when
# no LLM is configured (qa.enabled is false by default in alpha-go/configs/alpha_go.yaml),
# and the launchpad's PDF extractor never calls an LLM.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# --- Advanced overrides: leave commented unless you know you need them -----------
# Only for native services whose working directory is outside the checkout.
# PDFS_PROJECT_ROOT=/absolute/path/to/repository
# Only to use a bridge file other than the checkout's estate.json.
# PDFS_ESTATE_BRIDGE=/absolute/path/to/repository/estate.json
# Moves the writable legacy report cache (default <repo>/data/reports). The Estate's
# own report views are found through estate.json and need no setting here.
# PDFS_REPORTS_DIR=/absolute/path/to/report-cache
# Moves generated workbooks. The launchpad only opens results under <repo>/outputs,
# so setting this hides finished workbooks from it.
# PDFS_OUTPUTS_DIR=/absolute/path/to/repository/outputs
# Explicit Alpha Go paths, read by the Airflow task and the manual audit commands in
# ALPHA_ESTATE_SECOND_MACHINE_TEST.md. The launchpad derives them from the Estate.
# PDFS_ALPHA_ROOT=/absolute/path/to/repository/alpha-go
# PDFS_ALPHA_CORPUS=/Volumes/<USB name>/bmv-estate-v1/projections/alpha-go
# PDFS_ALPHA_INDEX=/Volumes/<USB name>/bmv-estate-v1/indexes/alpha_go.db
# PDFS_ALPHA_CONFIG=/absolute/path/to/repository/alpha-go/configs/alpha_go.yaml
# PDFS_ALPHA_PYTHON=/absolute/path/to/repository/alpha-go/.venv312/bin/python

# Alpha Go consumer wiring. Required by `process-estate-outbox audit-alpha`,
# `reconcile-alpha`, and `scripts/refresh_analyst_estate.py`. The paths below
# are the standard layout: Alpha's code lives in the checkout, its corpus and
# index live on the external estate.
PDFS_ALPHA_ROOT=/absolute/path/to/repository/alpha-go
PDFS_ALPHA_CORPUS=/absolute/path/on/external/disk/document-estate/projections/alpha-go
PDFS_ALPHA_INDEX=/absolute/path/on/external/disk/document-estate/indexes/alpha_go.db
PDFS_ALPHA_CONFIG=/absolute/path/to/repository/alpha-go/configs/alpha_go.yaml
PDFS_ALPHA_PYTHON=/absolute/path/to/repository/alpha-go/.venv312/bin/python

# One identifier per index generation, never reused. `portable-estate-v2` is the
# complete 384-dimension build that replaced the partial 10-document v1 on
# 2026-08-04. Bump this whenever the index is rebuilt; see
# docs/ALPHA_GO_ESTATE_SYNC.md, "Index generations".
PDFS_ALPHA_TARGET_ID=portable-estate-v2

# Required only for opt-in SEC EDGAR network fetches. SEC fair-access policy
# requires a descriptive application name and a monitored contact address.
# SEC_EDGAR_USER_AGENT="bmv-filings-platform/0.1 operations@example.com"
