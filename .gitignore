alpha-go/eval/sentiment_sample2_unlabeled.yaml

# All Earnings inventories, private analyst inputs, generated reports, and the
# vendored downloader cache are external/runtime data rather than source.
earnings/audit/
earnings/data/
earnings/outputs/
earnings/vendor/alpha-go/data/

# Generated deliverables: outputs/<Company>/{csv,excel,validation}/ is produced
# by scripts/build_segments.py. Declared here so the phase manifest can name it
# as an output location without a fresh clone failing for its absence.
outputs/

# Build and packaging by-products
build/
*.egg-info/
