soft/data/bmv_equity_roster.csv

# Bloomberg exports stay with the private data estate. Keep the explicitly
# documented synthetic fixture so a clean clone retains one runnable example.
soft/data/bloomberg/*.csv
!soft/data/bloomberg/walmex.csv

# Private/generated Earnings research artifacts. Source, configs, and tests are
# versioned; model inventories, analyst workbooks, rendered results, and raw
# vendor snapshots stay with the external data bundle.
earnings/audit/model_vintage_inventory.csv
earnings/data/analyst/
earnings/outputs/
earnings/vendor/alpha-go/data/bmv/archive_index.html

# Generated deliverables: outputs/<Company>/{csv,excel,validation}/ is produced
# by scripts/build_segments.py. Declared here so the phase manifest can name it
# as an output location without a fresh clone failing for its absence.
outputs/

# Build and packaging by-products
build/
*.egg-info/
